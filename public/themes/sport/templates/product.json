                    }
                  },
                  "block_order": [
                    "text"
                  ]
                },
                "row_2": {
                  "type": "_accordion-row",
                  "settings": {
                    "heading": "Livraison & retours",
                    "open_by_default": false
                  },
                  "blocks": {
                    "text": {
                      "type": "text",
                      "settings": {
                        "text": "<p>Expédition sous 24h ouvrées avec suivi. Livraison offerte dès 35€. Vous disposez de 30 jours pour changer d'avis : retour simple et remboursement intégral.</p>",
                        "type_preset": "rte",
                        "width": "100%"
                      }
                    }
                  },
                  "block_order": [
                    "text"
                  ]
                },
                "row_3": {
                  "type": "_accordion-row",
                  "settings": {
                    "heading": "Garantie",
                    "open_by_default": false
                  },
                  "blocks": {
                    "text": {
                      "type": "text",
                      "settings": {
                        "text": "<p>Tous nos accessoires sont garantis 1 an. En cas de souci, notre service client vous répond sous 24h et remplace l'article si besoin.</p>",
                        "type_preset": "rte",
                        "width": "100%"
                      }
                    }
                  },
                  "block_order": [
                    "text"
                  ]
                }
              },
              "block_order": [
                "row_1",
                "row_2",
                "row_3"
              ]
            }
