    "lf_faq_4": {
      "type": "lf-faq",
      "settings": {
        "scheme": "light",
        "eyebrow": "FAQ",
        "heading": "Vos questions, nos réponses"
      },
      "blocks": {
        "question_1": {
          "type": "question",
          "settings": {
            "question": "Je débute, est-ce pour moi ?",
            "answer": "<p>Oui : tous nos accessoires s'adaptent à votre niveau. Commencez doucement, quelques minutes par jour, et augmentez à votre rythme.</p>"
          }
        },
        "question_2": {
          "type": "question",
          "settings": {
            "question": "Faut-il beaucoup de place ?",
            "answer": "<p>Non. Tous nos produits sont compacts et se rangent sous un lit ou dans un placard. Un tapis suffit pour s'entraîner.</p>"
          }
        },
        "question_3": {
          "type": "question",
          "settings": {
            "question": "La ceinture EMS remplace-t-elle le sport ?",
            "answer": "<p>Non, c'est un complément de votre activité physique. Elle ne s'utilise pas en cas de pacemaker, de grossesse ou de problème cardiaque.</p>"
          }
        },
        "question_4": {
          "type": "question",
          "settings": {
            "question": "Et si le produit ne me convient pas ?",
            "answer": "<p>Vous avez 30 jours pour l'essayer. S'il ne vous plaît pas, on vous rembourse.</p>"
          }
        },
        "question_5": {
          "type": "question",
          "settings": {
            "question": "Quels sont les délais de livraison ?",
            "answer": "<p>Les commandes passées avant 14h partent le jour même, avec suivi. Livraison offerte dès 35€.</p>"
          }
        }
      },
