{%- doc -%}
  Five-star rating row.
  @param {number} [rating]
{%- enddoc -%}
{%- assign r = rating | default: 5 | plus: 0 -%}
<span class="lf-stars" aria-label="{{ r }} / 5">
  {%- for i in (1..5) -%}
    <svg viewBox="0 0 20 20" width="14" height="14" aria-hidden="true" class="{% if i > r %}lf-star--off{% endif %}"><path d="M10 1.5l2.6 5.5 6 .7-4.4 4.1 1.2 5.9L10 14.8l-5.4 2.9 1.2-5.9L1.4 7.7l6-.7z" fill="currentColor"/></svg>
  {%- endfor -%}
</span>
