{%- doc -%}
  Renders a Shopify image if set, otherwise an external URL, otherwise a placeholder.
  @param {image} [image]
  @param {string} [url]
  @param {string} [alt]
  @param {number} [width]
  @param {string} [loading]
  @param {string} [class]
{%- enddoc -%}
{%- liquid
  assign w = width | default: 1200
  assign lazy = loading | default: 'lazy'
-%}
{%- if image != blank -%}
  {{ image | image_url: width: w | image_tag: loading: lazy, alt: alt, class: class, sizes: '(min-width: 990px) 50vw, 100vw' }}
{%- elsif url != blank -%}
  {%- if url contains 'asset:' -%}
    {%- assign src = url | remove_first: 'asset:' | asset_url -%}
  {%- elsif url contains 'images.unsplash.com' -%}
    {%- capture src -%}{{ url }}?w={{ w }}&q=80&auto=format&fit=crop{%- endcapture -%}
  {%- else -%}
    {%- assign src = url -%}
  {%- endif -%}
  <img src="{{ src }}" alt="{{ alt | escape }}" loading="{{ lazy }}" class="{{ class }}" width="{{ w }}" height="{{ w | times: 1.25 | round }}">
{%- else -%}
  {{ 'image' | placeholder_svg_tag: 'lf-placeholder' }}
{%- endif -%}
