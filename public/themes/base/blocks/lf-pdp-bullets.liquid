{%- assign lines = block.settings.items | newline_to_br | split: '<br />' -%}
<ul class="lf-pdp-bullets" {{ block.shopify_attributes }}>
  {%- for line in lines -%}
    {%- assign l = line | strip -%}
    {%- if l != blank -%}<li>{{ l }}</li>{%- endif -%}
  {%- endfor -%}
</ul>

{% schema %}
{
  "name": "LF Bullets",
  "settings": [
    { "type": "textarea", "id": "items", "label": "Bullets (one per line)", "default": "Résultats visibles dès la 1re utilisation\nSatisfaite ou remboursée 30 jours\nLivraison offerte en 48h" }
  ],
  "presets": [{ "name": "LF Bullets" }]
}
{% endschema %}
