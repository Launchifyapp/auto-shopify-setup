<div class="lf-pdp-trust" {{ block.shopify_attributes }}>
  {%- for i in (1..4) -%}
    {%- capture icon_key -%}icon_{{ i }}{%- endcapture -%}
    {%- capture text_key -%}text_{{ i }}{%- endcapture -%}
    {%- if block.settings[text_key] != blank -%}
      <div class="lf-pdp-trust__item"><span>{{ block.settings[icon_key] }}</span>{{ block.settings[text_key] }}</div>
    {%- endif -%}
  {%- endfor -%}
</div>
{%- if block.settings.show_payment -%}
  <div class="lf-pdp-payments">
    {%- for type in shop.enabled_payment_types -%}{{ type | payment_type_svg_tag: class: 'lf-pay' }}{%- endfor -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "LF Trust",
  "settings": [
    { "type": "text", "id": "icon_1", "label": "Icon 1", "default": "🚚" },
    { "type": "text", "id": "text_1", "label": "Text 1", "default": "Livraison offerte" },
    { "type": "text", "id": "icon_2", "label": "Icon 2", "default": "↺" },
    { "type": "text", "id": "text_2", "label": "Text 2", "default": "Retours 30 jours" },
    { "type": "text", "id": "icon_3", "label": "Icon 3", "default": "🔒" },
    { "type": "text", "id": "text_3", "label": "Text 3", "default": "Paiement sécurisé" },
    { "type": "text", "id": "icon_4", "label": "Icon 4", "default": "★" },
    { "type": "text", "id": "text_4", "label": "Text 4", "default": "Garantie 1 an" },
    { "type": "checkbox", "id": "show_payment", "label": "Show payment icons", "default": true }
  ],
  "presets": [{ "name": "LF Trust" }]
}
{% endschema %}
