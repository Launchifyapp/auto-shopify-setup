{%- comment -%}
  Rating line under the badge. Shows the store's OWN rating only (reviews.rating / reviews.rating_count,
  the standard metafields filled by review apps such as Judge.me). Without own reviews yet, it links to
  the public buyer-review summary instead of showing a number.
{%- endcomment -%}
{%- liquid
  assign p = closest.product
  assign rating = p.metafields.reviews.rating.value.rating
  assign count = p.metafields.reviews.rating_count.value | default: 0
  assign summary = p.metafields.launchify.buyer_summary.value
  assign fr = false
  if summary.lang == 'fr'
    assign fr = true
  elsif summary == blank and request.locale.iso_code contains 'fr'
    assign fr = true
  endif
-%}
<div class="lf-pdp-rating" {{ block.shopify_attributes }}>
  {%- if block.settings.badge != blank -%}<span class="lf-badge lf-badge--sale">{{ block.settings.badge }}</span>{%- endif -%}
  {%- if rating != blank and count > 0 -%}
    <a href="#lf-reviews" class="lf-rating">
      {% render 'lf-stars', rating: rating %}
      <span>{{ rating | round: 1 }}</span>
      <span class="lf-pdp-rating__count">({{ count }} {{ block.settings.label }})</span>
    </a>
  {%- elsif summary != blank -%}
    <a href="#lf-reviews" class="lf-rating">
      <span class="lf-pdp-rating__count">{% if fr %}Ce qu'en disent les acheteurs{% else %}What buyers say{% endif %}</span>
    </a>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "LF Rating",
  "settings": [
    { "type": "text", "id": "badge", "label": "Badge", "default": "Best-seller" },
    { "type": "text", "id": "label", "label": "Reviews label", "default": "avis" },
    { "type": "paragraph", "content": "Shows your own review app's rating (reviews.rating metafield). No rating is shown until you have real reviews." }
  ],
  "presets": [{ "name": "LF Rating" }]
}
{% endschema %}
