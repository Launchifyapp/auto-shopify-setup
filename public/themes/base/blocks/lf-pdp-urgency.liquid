<div class="lf-pdp-urgency" {{ block.shopify_attributes }}>
  {%- if block.settings.stock_text != blank -%}
    <p class="lf-pdp-urgency__stock"><span class="lf-dot"></span>{{ block.settings.stock_text }}</p>
  {%- endif -%}
  {%- if block.settings.cutoff_text != blank -%}
    <p class="lf-pdp-urgency__ship" data-lf-cutoff="{{ block.settings.cutoff_hour }}">🚚 {{ block.settings.cutoff_text }} <strong data-lf-left></strong></p>
    <script>
      (function () {
        var el = document.currentScript.previousElementSibling;
        var out = el.querySelector('[data-lf-left]');
        var hour = parseInt(el.getAttribute('data-lf-cutoff'), 10) || 14;
        function tick() {
          var now = new Date(), end = new Date(now);
          end.setHours(hour, 0, 0, 0);
          if (end <= now) end.setDate(end.getDate() + 1);
          var d = Math.floor((end - now) / 1000);
          out.textContent = Math.floor(d / 3600) + 'h ' + String(Math.floor((d % 3600) / 60)).padStart(2, '0') + 'min';
        }
        tick();
        setInterval(tick, 30000);
      })();
    </script>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "LF Urgency",
  "settings": [
    { "type": "text", "id": "stock_text", "label": "Stock text", "default": "Forte demande : stock limité" },
    { "type": "text", "id": "cutoff_text", "label": "Shipping cutoff text", "default": "Commandez dans les" },
    { "type": "range", "id": "cutoff_hour", "label": "Cutoff hour", "min": 8, "max": 22, "step": 1, "default": 14 }
  ],
  "presets": [{ "name": "LF Urgency" }]
}
{% endschema %}
