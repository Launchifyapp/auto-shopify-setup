<section class="lf-section lf-scheme-{{ section.settings.scheme }}">
  <div class="lf-container">
    <div class="lf-split lf-split--reverse">
      <div class="lf-split__media">
        {% render 'lf-img', image: section.settings.image, url: section.settings.image_url, alt: section.settings.name, width: 1200 %}
      </div>
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="lf-eyebrow lf-eyebrow--pill">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="lf-h2">{{ section.settings.heading }}</h2>
        <blockquote class="lf-quote">{{ section.settings.quote }}</blockquote>
        <div class="lf-signature"><strong>{{ section.settings.name }}</strong>{{ section.settings.role }}</div>
        {%- if section.settings.proof != blank -%}<div class="lf-proof">{% render 'lf-stars', rating: 5 %}<span>{{ section.settings.proof }}</span></div>{%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "LF Expert",
  "settings": [
    { "type": "select", "id": "scheme", "label": "Color scheme", "default": "light", "options": [
      { "value": "light", "label": "Light" }, { "value": "soft", "label": "Soft" }, { "value": "dark", "label": "Dark" }, { "value": "accent", "label": "Accent" }
    ] },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Recommandé par les experts" },
    { "type": "textarea", "id": "quote", "label": "Quote" },
    { "type": "text", "id": "name", "label": "Name" },
    { "type": "text", "id": "role", "label": "Role" },
    { "type": "text", "id": "proof", "label": "Proof line" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "image_url", "label": "Image URL (fallback)" }
  ],
  "presets": [{ "name": "LF Expert" }]
}
{% endschema %}
