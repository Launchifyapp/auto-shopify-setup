{%- assign is_strip = false -%}
{%- if section.settings.layout == 'strip' -%}{%- assign is_strip = true -%}{%- endif -%}
<section class="lf-section lf-scheme-{{ section.settings.scheme }}"{% if is_strip %} style="padding: 0"{% endif %}>
  <div class="lf-container">
    {%- if section.settings.heading != blank and is_strip == false -%}
      <div class="lf-head lf-head--center">
        {%- if section.settings.eyebrow != blank -%}<p class="lf-eyebrow lf-eyebrow--pill">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="lf-h2">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}<p class="lf-lead">{{ section.settings.text }}</p>{%- endif -%}
      </div>
    {%- endif -%}
    <div class="lf-benefits{% if is_strip %} lf-benefits--strip{% endif %}" style="--lf-cols: {{ section.blocks.size | at_most: 4 }}">
      {%- for block in section.blocks -%}
        <div class="lf-benefit" {{ block.shopify_attributes }}>
          <div class="lf-benefit__icon">{{ block.settings.icon }}</div>
          <div>
            <h3 class="lf-h3">{{ block.settings.title }}</h3>
            {%- if block.settings.text != blank -%}<p>{{ block.settings.text }}</p>{%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "LF Benefits",
  "settings": [
    { "type": "select", "id": "scheme", "label": "Color scheme", "default": "light", "options": [
      { "value": "light", "label": "Light" }, { "value": "soft", "label": "Soft" }, { "value": "dark", "label": "Dark" }, { "value": "accent", "label": "Accent" }
    ] },
    { "type": "select", "id": "layout", "label": "Layout", "default": "cards", "options": [
      { "value": "cards", "label": "Cards" }, { "value": "strip", "label": "Trust strip" }
    ] },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading" },
    { "type": "inline_richtext", "id": "text", "label": "Text" }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon (emoji)", "default": "✦" },
        { "type": "text", "id": "title", "label": "Title", "default": "Avantage" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [{ "name": "LF Benefits", "blocks": [{ "type": "benefit" }, { "type": "benefit" }, { "type": "benefit" }] }]
}
{% endschema %}
