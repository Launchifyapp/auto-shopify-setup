<section class="lf-section lf-scheme-{{ section.settings.scheme }}">
  <div class="lf-container">
    <div class="lf-head lf-head--center">
      {%- if section.settings.eyebrow != blank -%}<p class="lf-eyebrow lf-eyebrow--pill">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="lf-h2">{{ section.settings.heading }}</h2>
    </div>
    <div class="lf-faq">
      {%- for block in section.blocks -%}
        <details {{ block.shopify_attributes }}{% if forloop.first %} open{% endif %}>
          <summary>{{ block.settings.question }}</summary>
          <div class="lf-faq__answer">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "LF FAQ",
  "settings": [
    { "type": "select", "id": "scheme", "label": "Color scheme", "default": "light", "options": [
      { "value": "light", "label": "Light" }, { "value": "soft", "label": "Soft" }, { "value": "dark", "label": "Dark" }, { "value": "accent", "label": "Accent" }
    ] },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "FAQ" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Vos questions" }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Quand vais-je voir des résultats ?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>La plupart de nos clientes voient une différence dès 7 jours.</p>" }
      ]
    }
  ],
  "presets": [{ "name": "LF FAQ", "blocks": [{ "type": "question" }, { "type": "question" }, { "type": "question" }] }]
}
{% endschema %}
