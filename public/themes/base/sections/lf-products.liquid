<section class="lf-section lf-scheme-{{ section.settings.scheme }}">
  <div class="lf-container">
    <div class="lf-head">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="lf-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="lf-h2">{{ section.settings.heading }}</h2>
      </div>
      {%- if section.settings.link_label != blank -%}
        <a class="lf-link" href="{{ section.settings.link | default: routes.all_products_collection_url }}">{{ section.settings.link_label }}</a>
      {%- endif -%}
    </div>
    <div class="lf-grid" style="--lf-cols: {{ section.settings.columns }}">
      {%- for block in section.blocks -%}
        {%- comment -%}
          "handle": the product's base handle. Launchify imports products with a random suffix
          (pot-auto-arrosant-3f2a1), so the card finds the store's product whose handle starts with
          it, and is hidden when the store doesn't sell that product.
        {%- endcomment -%}
        {%- liquid
          assign p = block.settings.product
          assign missing = false
          if p == blank and block.settings.handle != blank
            assign prefix = block.settings.handle | append: '-'
            assign prefix_size = prefix | size
            for candidate in collections.all.products
              assign head = candidate.handle | slice: 0, prefix_size
              if candidate.handle == block.settings.handle or head == prefix
                assign p = candidate
                break
              endif
            endfor
            if p == blank
              assign missing = true
            endif
          endif
          if p != blank
            assign title = p.title
            assign url = p.url
            assign price = p.price | money
            assign compare = blank
            assign sale = blank
            if p.compare_at_price > p.price
              assign compare = p.compare_at_price | money
              assign pct = p.compare_at_price | minus: p.price | times: 100 | divided_by: p.compare_at_price
              assign sale = '-' | append: pct | append: '%'
            endif
            assign img = p.featured_image
          else
            assign title = block.settings.title
            assign url = block.settings.link | default: routes.all_products_collection_url
            assign price = block.settings.price
            assign compare = block.settings.compare_price
            assign img = block.settings.image
            assign sale = block.settings.sale_badge
          endif
        -%}
        {%- if missing -%}{%- continue -%}{%- endif -%}
        <a class="lf-card" href="{{ url }}" {{ block.shopify_attributes }}>
          <div class="lf-card__media">
            {% render 'lf-img', image: img, url: block.settings.image_url, alt: title, width: 900 %}
            {%- if block.settings.badge != blank or sale != blank -%}
              <div class="lf-badges">
                {%- if block.settings.badge != blank -%}<span class="lf-badge">{{ block.settings.badge }}</span>{%- else -%}<span></span>{%- endif -%}
                {%- if sale != blank -%}<span class="lf-badge lf-badge--sale">{{ sale }}</span>{%- endif -%}
              </div>
            {%- endif -%}
          </div>
          <div class="lf-card__body">
            {%- if block.settings.reviews != blank -%}
              <div class="lf-card__rating">{% render 'lf-stars', rating: 5 %}<span>{{ block.settings.rating }} ({{ block.settings.reviews }})</span></div>
            {%- endif -%}
            <h3 class="lf-card__title">{{ title }}</h3>
            {%- if block.settings.subtitle != blank -%}<p class="lf-card__sub">{{ block.settings.subtitle }}</p>{%- endif -%}
            <div class="lf-price"><span>{{ price }}</span>{%- if compare != blank -%}<s>{{ compare }}</s>{%- endif -%}</div>
            {%- if section.settings.button_label != blank -%}<span class="lf-btn lf-btn--block">{{ section.settings.button_label }}</span>{%- endif -%}
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "LF Products",
  "settings": [
    { "type": "select", "id": "scheme", "label": "Color scheme", "default": "light", "options": [
      { "value": "light", "label": "Light" }, { "value": "soft", "label": "Soft" }, { "value": "dark", "label": "Dark" }, { "value": "accent", "label": "Accent" }
    ] },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Best-sellers" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Tout voir" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "text", "id": "button_label", "label": "Card button label", "default": "Ajouter au panier" },
    { "type": "range", "id": "columns", "label": "Columns", "min": 2, "max": 5, "step": 1, "default": 4 }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        { "type": "product", "id": "product", "label": "Product (overrides manual fields)" },
        { "type": "text", "id": "handle", "label": "Product handle prefix (hides the card when absent)" },
        { "type": "text", "id": "title", "label": "Title", "default": "Produit" },
        { "type": "text", "id": "subtitle", "label": "Subtitle" },
        { "type": "text", "id": "price", "label": "Price", "default": "29,00 €" },
        { "type": "text", "id": "compare_price", "label": "Compare-at price" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "image_url", "label": "Image URL (fallback)" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "text", "id": "badge", "label": "Badge" },
        { "type": "text", "id": "sale_badge", "label": "Sale badge" },
        { "type": "text", "id": "rating", "label": "Rating", "default": "4.8" },
        { "type": "text", "id": "reviews", "label": "Review count" }
      ]
    }
  ],
  "presets": [{ "name": "LF Products", "blocks": [{ "type": "product" }, { "type": "product" }, { "type": "product" }, { "type": "product" }] }]
}
{% endschema %}
