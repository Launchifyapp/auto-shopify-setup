<section class="lf-section lf-scheme-{{ section.settings.scheme }}">
  <div class="lf-container">
    <div class="lf-head">
      <h2 class="lf-h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.link_label != blank -%}<a class="lf-link" href="{{ routes.all_products_collection_url }}">{{ section.settings.link_label }}</a>{%- endif -%}
    </div>
    <div class="lf-cats" style="--lf-cols: {{ section.blocks.size | at_most: 4 }}">
      {%- for block in section.blocks -%}
        <a class="lf-cat" href="{{ block.settings.link | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>
          {% render 'lf-img', image: block.settings.image, url: block.settings.image_url, alt: block.settings.label, width: 800 %}
          <span class="lf-cat__label"><strong>{{ block.settings.label }}</strong><span>{{ section.settings.cta }} →</span></span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "LF Categories",
  "settings": [
    { "type": "select", "id": "scheme", "label": "Color scheme", "default": "light", "options": [
      { "value": "light", "label": "Light" }, { "value": "soft", "label": "Soft" }, { "value": "dark", "label": "Dark" }, { "value": "accent", "label": "Accent" }
    ] },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Acheter par catégorie" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Tout voir" },
    { "type": "text", "id": "cta", "label": "Tile CTA", "default": "Découvrir" }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Visage" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "image_url", "label": "Image URL (fallback)" }
      ]
    }
  ],
  "presets": [{ "name": "LF Categories", "blocks": [{ "type": "category" }, { "type": "category" }, { "type": "category" }, { "type": "category" }] }]
}
{% endschema %}
